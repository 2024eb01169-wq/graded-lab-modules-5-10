#include <stdio.h>
#include <unistd.h>
#include <sys/wait.h>

int main() {
    // Create 3 child processes
    for(int i=0; i<3; i++) {
        if(fork() == 0) return 0; // Child exits immediately
    }

    int pid;
    // Parent waits for each child to finish to prevent zombies
    while((pid = wait(NULL)) > 0) {
        printf("Cleaned child PID: %d\n", pid);
    }
    
    return 0;
}
